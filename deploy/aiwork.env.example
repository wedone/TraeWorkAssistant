# AI Work 助手 Web 版（aiwork-server）环境配置
# 安装位置：/etc/aiwork/aiwork.env（权限 0600，由 systemd EnvironmentFile 读取）
# 修改后执行：sudo systemctl restart aiwork-server

# 数据目录：SQLite / Stronghold 快照 / conf / logs 均在此目录
# 修改此路径时，必须同步调整 systemd 单元的 StateDirectory / ReadWritePaths
AIWORK_DATA_DIR=/var/lib/aiwork

# 前端静态资源目录（发布包内 dist）
AIWORK_WEB_DIST=/opt/aiwork/dist

# 监听地址：默认仅本机，公网访问请经 Caddy/Nginx 反代
# 直接对外暴露时可改为 0.0.0.0:8383，并务必配置防火墙与 TLS
AIWORK_LISTEN_ADDR=127.0.0.1:8383

# 服务端没有本机 WorkBuddy/CodeBuddy 客户端：
# 关闭云端取数失败时的本机端口探测兜底，避免串行探测造成长阻塞
AIWORK_DISABLE_LOCAL_QUOTA=1

# 管理面令牌：留空则首启自动生成 /var/lib/aiwork/conf/admin_token
# 生产建议显式注入强随机值（如 openssl rand -hex 32）
AIWORK_ADMIN_TOKEN=

# 敏感数据加密密钥：留空则首启自动生成 /var/lib/aiwork/conf/vault_key.bin
# 该文件丢失 = 已存账号凭据永久不可解密；跨机迁移请显式设置相同值
AIWORK_VAULT_KEY=

# 调度时区：签到 / 续期 / 积分快照按本地时刻触发
TZ=Asia/Shanghai
